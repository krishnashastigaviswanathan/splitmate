generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  passwordHash        String
  upiId               String?
  createdAt           DateTime           @default(now())
  memberships         GroupMember[]
  paidExpenses        Expense[]          @relation("PaidExpenses")
  splits              ExpenseSplit[]
  comments            ExpenseComment[]
  settlementsSent     Settlement[]       @relation("SettlementsSent")
  settlementsReceived Settlement[]       @relation("SettlementsReceived")
  messages            RoommateMessage[]
}

model Group {
  id          String            @id @default(cuid())
  name        String
  emoji       String            @default("🏠")
  currency    String            @default("INR")
  monthlyGoal Int?
  inviteCode  String            @unique
  createdAt   DateTime          @default(now())
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  messages    RoommateMessage[]
}

model GroupMember {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Expense {
  id                String           @id @default(cuid())
  description       String
  amount            Int
  category          String
  splitType         String
  receiptUrl        String?
  isRecurring       Boolean          @default(false)
  recurringInterval String?
  nextDueDate       DateTime?
  groupId           String
  paidById          String
  expenseDate       DateTime         @default(now())
  createdAt         DateTime         @default(now())
  group             Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy            User             @relation("PaidExpenses", fields: [paidById], references: [id])
  splits            ExpenseSplit[]
  comments          ExpenseComment[]
}

model ExpenseSplit {
  id        String  @id @default(cuid())
  expenseId String
  userId    String
  amount    Int
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExpenseComment {
  id        String   @id @default(cuid())
  expenseId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settlement {
  id         String   @id @default(cuid())
  groupId    String
  fromUserId String
  toUserId   String
  amount     Int
  note       String?
  createdAt  DateTime @default(now())
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser   User     @relation("SettlementsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("SettlementsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
}

model RoommateMessage {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  content   String
  emoji     String?  @default("💬")
  tag       String?  @default("CHAT")
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
